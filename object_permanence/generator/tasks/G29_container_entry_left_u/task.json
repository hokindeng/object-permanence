    "parameters": {
      "occupied_lane": {
        "type": "choice",
        "values": [0, 1],
        "binding": {
          "operation": "replace",
          "constant": "PRIMARY_LANE"
        }
      },
      "second_ball_present": {
        "type": "choice",
        "values": [0, 1],
        "binding": {
          "operation": "replace",
          "constant": "SECOND_BALL_PRESENT"
        }
      },
      "ball_radius_scale": {
        "type": "uniform",
        "min": 0.65,
        "max": 1.35,
        "precision": 4,
        "binding": {
          "operation": "multiply",
          "constant": "BALL_RADIUS"
        }
      }
    }
  }
